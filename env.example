# ─── Appwrite connection ──────────────────────────────────────────────────────
# Shared by the web app and the Appwrite Functions. The NEXT_PUBLIC_* names from
# the previous Next.js app are still read as a fallback.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=63ef1792594ff4f50de2
# Server key — never expose it to the browser. Scopes: rows.read, rows.write,
# tables.read (feeds, votes, comments) and sessions.write (sign-in / sign-up /
# "Continue with Appwrite"). Functions need their own scopes (see README).
APPWRITE_API_KEY=your-server-api-key-here

# ─── Tables DB (env names keep the legacy *_COLLECTION_ID suffix) ─────────────
APPWRITE_DATABASE_ID=688f787e002c78bd299f
APPWRITE_POSTS_COLLECTION_ID=688f78a20022f61836ff
APPWRITE_VOTES_COLLECTION_ID=68910fc60001839e0ada
APPWRITE_COMMENTS_COLLECTION_ID=68993e6c003af0fe657f
APPWRITE_KEYS_COLLECTION_ID=keys
APPWRITE_DAILY_TOPICS_COLLECTION_ID=daily_topics
APPWRITE_TOPICS_COLLECTION_ID=topics
# Channels (created by `npm run appwrite:setup`; these are the defaults)
APPWRITE_CHANNELS_COLLECTION_ID=channels
APPWRITE_CHANNEL_MEMBERS_COLLECTION_ID=channel_members
APPWRITE_CHANNEL_ICONS_BUCKET_ID=channel-icons
# People and messages (created by `npm run appwrite:setup`; these are the defaults)
APPWRITE_PROFILES_COLLECTION_ID=profiles
APPWRITE_FOLLOWS_COLLECTION_ID=user_follows
APPWRITE_BLOCKS_COLLECTION_ID=user_blocks
APPWRITE_CONVERSATIONS_COLLECTION_ID=conversations
APPWRITE_CONVERSATION_MEMBERS_COLLECTION_ID=conversation_members
APPWRITE_MESSAGES_COLLECTION_ID=messages
APPWRITE_MESSAGE_REACTIONS_COLLECTION_ID=message_reactions

# ─── Web app ──────────────────────────────────────────────────────────────────
# Canonical public origin (SEO metadata, social cards). Defaults to https://refetch.io
SITE_URL=https://refetch.io

# Optional — "refetchers online" + visitors chart
# PLAUSIBLE_API_KEY=your-plausible-api-key-here
# PLAUSIBLE_SITE_ID=refetch.io

# ─── OpenAI (Scout + Enhancement functions) ───────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
# Optional; default gpt-4o-mini
OPENAI_MODEL=gpt-4o-mini
# Enhancement: set to true to generate 12-locale title/description translations (default off)
# ENABLE_TRANSLATIONS=true

# ─── Scout function — comma-separated site roots to crawl ─────────────────────
SCOUT_TARGET_WEBSITES=https://techcrunch.com,https://theverge.com,https://arstechnica.com,https://wired.com,https://venturebeat.com,https://engadget.com,https://infoq.com,https://news.ycombinator.com,https://lobste.rs,https://reddit.com/r/programming,https://sciencedaily.com,https://nature.com/nature/technology,https://9to5mac.com,https://9to5google.com,https://theregister.com,https://zdnet.com,https://www.technologyreview.com/tag/the-algorithm

# ─── Readme function (GitHub + link base for generated README) ───────────────
README_ORIGIN=https://refetch.io
README_GITHUB_TOKEN=your-github-pat-here
README_GITHUB_OWNER=refetch-io
README_GITHUB_REPO=refetch
README_GITHUB_BRANCH=main
